{
  "openapi": "3.1.0",
  "info": {
    "title": "Strelle AV Matrix Server",
    "version": "1.0.0",
    "description": "Kreuzschiene für NDI® (Video), Dante® (Audio) und ST 2110 (über NMOS). Lesen und Schalten im Studionetz ohne Anmeldung; Schalt-Adressen gehen als GET und POST (Parameter in der Query oder als JSON-Body). Fest geschützte Ziele (Feld 'protected') lassen sich über keine Schnittstelle verändern. MCP (Streamable HTTP) unter /mcp, schreibende MCP-Werkzeuge mit Bearer-Token."
  },
  "servers": [
    {
      "url": "http://matrixpi.local:8088",
      "description": "Beispiel"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Zugangsschlüssel; nur für schreibende MCP-Werkzeuge nötig"
      }
    }
  },
  "paths": {
    "/api/state": {
      "get": {
        "summary": "Kompletter Zustand: Protokolle, Quellen, Ziele, Presets, Sperrliste",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/status": {
      "get": {
        "summary": "Kompakter Zustand: routes {Ziel-id: Quelle}, presets {id: aktiv}",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/choices": {
      "get": {
        "summary": "Auswahllisten: Ziele, Quellen, Presets (für Companion)",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
