    "/api/preview": {
      "get": {
        "summary": "Zustand der NDI-Vorschau: verfügbar, offene Empfänger, Grenzen",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "source",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "optional: Zustand dieser Quelle"
          }
        ]
      }
    },
    "/api/preview.jpg": {
      "get": {
        "summary": "Standbild einer NDI-Quelle (JPEG aus dem Proxy-Stream, wenige Sekunden zwischengespeichert)",
        "parameters": [
          {
            "name": "source",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "NDI-Quelle: id oder Label"
          },
          {
            "name": "w",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Breite in Pixel, 64–640 (Vorgabe 320)"
          }
        ],
        "responses": {
          "200": {
            "description": "image/jpeg; Header X-Preview-Age (Sekunden), X-Preview-Size",
            "content": {
              "image/jpeg": {}
            }
          },
          "404": {
            "description": "Quelle offline oder unbekannt (JSON, error: offline | unknown_source)"
          },
          "415": {
            "description": "NDI|HX-Quelle, Decoder fehlt (error: unsupported_codec)"
          },
          "501": {
            "description": "NDI SDK nicht installiert (error: unavailable)"
          },
          "503": {
            "description": "Quelle liefert kein Bild (error: no_signal)"
          }
        }
      }
    },
    "/api/preview.mjpeg": {
      "get": {
        "summary": "Live-Vorschau einer NDI-Quelle als MJPEG-Stream (multipart/x-mixed-replace); höchstens eine Quelle gleichzeitig",
        "parameters": [
          {
            "name": "source",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "NDI-Quelle: id oder Label"
          },
          {
            "name": "w",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Breite in Pixel, 160–1280 (Vorgabe 640)"
          },
          {
            "name": "fps",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Bilder je Sekunde, 1–25 (Vorgabe 12.5)"
          }
        ],
        "responses": {
          "200": {
            "description": "multipart/x-mixed-replace; boundary=avmframe"
          },
          "404": {
            "description": "offline"
          },
          "501": {
            "description": "nicht verfügbar"
          }
        }
      }
    },
