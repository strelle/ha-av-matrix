# Kopieren nach server/local/deploy.env (nicht versioniert) und anpassen.
# Ziel des Ausrollens: SSH-Benutzer@Rechner (der Benutzer braucht kein sudo, aber "loginctl enable-linger")
AVM_TARGET=benutzer@matrixpi.local
# Optional: Datei mit den Einstellungen der Anlage für die Erstinstallation (Vorgabe: local/studio.json)
# AVM_STUDIO_FILE=local/studio.json
